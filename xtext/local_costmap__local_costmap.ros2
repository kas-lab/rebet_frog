local_costmap:
  artifacts:
    local_costmap:
      node: /local_costmap/local_costmap
      publishers:
        'clearing_endpoints':
          type: 'sensor_msgs/msg/PointCloud2'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'costmap':
          type: 'nav_msgs/msg/OccupancyGrid'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'costmap_raw':
          type: 'nav2_msgs/msg/Costmap'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'costmap_updates':
          type: 'map_msgs/msg/OccupancyGridUpdate'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'local_costmap/transition_event':
          type: 'lifecycle_msgs/msg/TransitionEvent'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'published_footprint':
          type: 'geometry_msgs/msg/PolygonStamped'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'voxel_grid':
          type: 'nav2_msgs/msg/VoxelGrid'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
      subscribers:
        '':
          type: 'rosgraph_msgs/msg/Clock'
        'footprint':
          type: 'geometry_msgs/msg/Polygon'
        '':
          type: 'sensor_msgs/msg/LaserScan'
      serviceservers:
        'clear_around_local_costmap':
          type: 'nav2_msgs/srv/ClearCostmapAroundRobot'
        'clear_entirely_local_costmap':
          type: 'nav2_msgs/srv/ClearEntireCostmap'
        'clear_except_local_costmap':
          type: 'nav2_msgs/srv/ClearCostmapExceptRegion'
        'get_costmap':
          type: 'nav2_msgs/srv/GetCostmap'
        'local_costmap/change_state':
          type: 'lifecycle_msgs/srv/ChangeState'
        'local_costmap/get_available_states':
          type: 'lifecycle_msgs/srv/GetAvailableStates'
        'local_costmap/get_available_transitions':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'local_costmap/get_state':
          type: 'lifecycle_msgs/srv/GetState'
        'local_costmap/get_transition_graph':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
      parameters:
        '/bond_disable_heartbeat_timeout':
          type: Boolean
          value: true
        'always_send_full_costmap':
          type: Boolean
          value: true
        'filters':
          type: Array[String]
          value: ['']
        'footprint':
          type: String
          value: "[]"
        'footprint_padding':
          type: Double
          value: 0.009999999776482582
        'global_frame':
          type: String
          value: "odom"
        'height':
          type: Integer
          value: 3
        'inflation_layer.cost_scaling_factor':
          type: Double
          value: 3.0
        'inflation_layer.enabled':
          type: Boolean
          value: true
        'inflation_layer.inflate_around_unknown':
          type: Boolean
          value: false
        'inflation_layer.inflate_unknown':
          type: Boolean
          value: false
        'inflation_layer.inflation_radius':
          type: Double
          value: 0.2
        'inflation_layer.plugin':
          type: String
          value: "nav2_costmap_2d::InflationLayer"
        'lethal_cost_threshold':
          type: Integer
          value: 100
        'map_topic':
          type: String
          value: "/map"
        'observation_sources':
          type: String
          value: ""
        'origin_x':
          type: Double
          value: 0.0
        'origin_y':
          type: Double
          value: 0.0
        'plugins':
          type: Array[String]
          value: ['voxel_layer', 'inflation_layer']
        'publish_frequency':
          type: Double
          value: 2.0
        'resolution':
          type: Double
          value: 0.05
        'robot_base_frame':
          type: String
          value: "base_link"
        'robot_radius':
          type: Double
          value: 0.22
        'rolling_window':
          type: Boolean
          value: true
        'track_unknown_space':
          type: Boolean
          value: false
        'transform_tolerance':
          type: Double
          value: 0.3
        'trinary_costmap':
          type: Boolean
          value: true
        'unknown_cost_value':
          type: Integer
          value: 255
        'update_frequency':
          type: Double
          value: 5.0
        'use_maximum':
          type: Boolean
          value: false
        'use_sim_time':
          type: Boolean
          value: true
        'voxel_layer.combination_method':
          type: Integer
          value: 1
        'voxel_layer.enabled':
          type: Boolean
          value: true
        'voxel_layer.footprint_clearing_enabled':
          type: Boolean
          value: true
        'voxel_layer.mark_threshold':
          type: Integer
          value: 0
        'voxel_layer.max_obstacle_height':
          type: Double
          value: 2.0
        'voxel_layer.min_obstacle_height':
          type: Double
          value: 0.0
        'voxel_layer.observation_sources':
          type: String
          value: "scan"
        'voxel_layer.origin_z':
          type: Double
          value: 0.0
        'voxel_layer.plugin':
          type: String
          value: "nav2_costmap_2d::VoxelLayer"
        'voxel_layer.publish_voxel_map':
          type: Boolean
          value: true
        'voxel_layer.scan.clearing':
          type: Boolean
          value: true
        'voxel_layer.scan.data_type':
          type: String
          value: "LaserScan"
        'voxel_layer.scan.expected_update_rate':
          type: Double
          value: 0.0
        'voxel_layer.scan.inf_is_valid':
          type: Boolean
          value: false
        'voxel_layer.scan.marking':
          type: Boolean
          value: true
        'voxel_layer.scan.max_obstacle_height':
          type: Double
          value: 2.0
        'voxel_layer.scan.min_obstacle_height':
          type: Double
          value: 0.0
        'voxel_layer.scan.observation_persistence':
          type: Double
          value: 0.0
        'voxel_layer.scan.obstacle_max_range':
          type: Double
          value: 2.5
        'voxel_layer.scan.obstacle_min_range':
          type: Double
          value: 0.0
        'voxel_layer.scan.raytrace_max_range':
          type: Double
          value: 3.0
        'voxel_layer.scan.raytrace_min_range':
          type: Double
          value: 0.0
        'voxel_layer.scan.sensor_frame':
          type: String
          value: ""
        'voxel_layer.scan.topic':
          type: String
          value: "/scan"
        'voxel_layer.unknown_threshold':
          type: Integer
          value: 15
        'voxel_layer.z_resolution':
          type: Double
          value: 0.05
        'voxel_layer.z_voxels':
          type: Integer
          value: 16
        'width':
          type: Integer
          value: 3
