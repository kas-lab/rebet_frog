turtlebot3_gazebo:
  artifacts:
    turtlebot3_diff_drive:
      node: turtlebot3_diff_drive
      publishers:
        'odom':
          type: 'nav_msgs/msg/Odometry'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'tf':
          type: 'tf2_msgs/msg/TFMessage'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
      subscribers:
        'clock':
          type: 'rosgraph_msgs/msg/Clock'
        'cmd_vel':
          type: 'geometry_msgs/msg/Twist'
      parameters:
        'use_sim_time':
          type: Boolean
          value: true
