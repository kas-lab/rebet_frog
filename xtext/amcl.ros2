nav2_amcl:
  artifacts:
    amcl:
      node: /amcl
      publishers:
        'amcl/transition_event':
          type: 'lifecycle_msgs/msg/TransitionEvent'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'amcl_pose':
          type: 'geometry_msgs/msg/PoseWithCovarianceStamped'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'bond':
          type: 'bond/msg/Status'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'particle_cloud':
          type: 'nav2_msgs/msg/ParticleCloud'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: best_effort
            durability: volatile
        'tf':
          type: 'tf2_msgs/msg/TFMessage'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
      subscribers:
        'bond':
          type: 'bond/msg/Status'
        'clock':
          type: 'rosgraph_msgs/msg/Clock'
        'initialpose':
          type: 'geometry_msgs/msg/PoseWithCovarianceStamped'
        'map':
          type: 'nav_msgs/msg/OccupancyGrid'
        'scan':
          type: 'sensor_msgs/msg/LaserScan'
      serviceservers:
        'amcl/change_state':
          type: 'lifecycle_msgs/srv/ChangeState'
        'amcl/get_available_states':
          type: 'lifecycle_msgs/srv/GetAvailableStates'
        'amcl/get_available_transitions':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'amcl/get_state':
          type: 'lifecycle_msgs/srv/GetState'
        'amcl/get_transition_graph':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'reinitialize_global_localization':
          type: 'std_srvs/srv/Empty'
        'request_nomotion_update':
          type: 'std_srvs/srv/Empty'
        'set_initial_pose':
          type: 'nav2_msgs/srv/SetInitialPose'
      parameters:
        '/bond_disable_heartbeat_timeout':
          type: Boolean
          value: true
        'alpha1':
          type: Double
          value: 0.2
        'alpha2':
          type: Double
          value: 0.2
        'alpha3':
          type: Double
          value: 0.2
        'alpha4':
          type: Double
          value: 0.2
        'alpha5':
          type: Double
          value: 0.2
        'always_reset_initial_pose':
          type: Boolean
          value: false
        'base_frame_id':
          type: String
          value: "base_footprint"
        'beam_skip_distance':
          type: Double
          value: 0.5
        'beam_skip_error_threshold':
          type: Double
          value: 0.9
        'beam_skip_threshold':
          type: Double
          value: 0.3
        'do_beamskip':
          type: Boolean
          value: false
        'first_map_only':
          type: Boolean
          value: false
        'global_frame_id':
          type: String
          value: "map"
        'initial_pose.x':
          type: Double
          value: 0.0
        'initial_pose.y':
          type: Double
          value: 0.0
        'initial_pose.yaw':
          type: Double
          value: 0.0
        'initial_pose.z':
          type: Double
          value: 0.0
        'lambda_short':
          type: Double
          value: 0.1
        'laser_likelihood_max_dist':
          type: Double
          value: 2.0
        'laser_max_range':
          type: Double
          value: 100.0
        'laser_min_range':
          type: Double
          value: -1.0
        'laser_model_type':
          type: String
          value: "likelihood_field"
        'map_topic':
          type: String
          value: "map"
        'max_beams':
          type: Integer
          value: 60
        'max_particles':
          type: Integer
          value: 2000
        'min_particles':
          type: Integer
          value: 500
        'odom_frame_id':
          type: String
          value: "odom"
        'pf_err':
          type: Double
          value: 0.05
        'pf_z':
          type: Double
          value: 0.99
        'recovery_alpha_fast':
          type: Double
          value: 0.0
        'recovery_alpha_slow':
          type: Double
          value: 0.0
        'resample_interval':
          type: Integer
          value: 1
        'robot_model_type':
          type: String
          value: "nav2_amcl::DifferentialMotionModel"
        'save_pose_rate':
          type: Double
          value: 0.5
        'scan_topic':
          type: String
          value: "scan"
        'set_initial_pose':
          type: Boolean
          value: false
        'sigma_hit':
          type: Double
          value: 0.2
        'tf_broadcast':
          type: Boolean
          value: true
        'transform_tolerance':
          type: Double
          value: 1.0
        'update_min_a':
          type: Double
          value: 0.2
        'update_min_d':
          type: Double
          value: 0.25
        'use_sim_time':
          type: Boolean
          value: true
        'z_hit':
          type: Double
          value: 0.5
        'z_max':
          type: Double
          value: 0.05
        'z_rand':
          type: Double
          value: 0.5
        'z_short':
          type: Double
          value: 0.05
