name FROGMaxSpeed;
import "rebetfrog.resolution";
import "frog.context";
rule DECREASE_TO_MED {
guard {
 	context(nearest_object < 0.10 OR power_draw > 40.0)
 	features(selected(rebet_frog.HI_SPEED)) 
 	}
action { select_variant(rebet_frog.MED_SPEED)}
};
rule DECREASE_TO_LOW {
guard {
 	context(nearest_object < 0.10 OR power_draw > 40.0)
 	features(selected(rebet_frog.MED_SPEED)) 
 	}
action { select_variant(rebet_frog.LOW_SPEED)}
};
rule INCREASE_TO_MED {
guard {
 	context(nearest_object > 0.15 OR power_draw <= 40.0 OR current_velocity < 0.40)
 	features(selected(rebet_frog.LOW_SPEED)) 
 	}
action { select_variant(rebet_frog.MED_SPEED)}
};
rule INCREASE_TO_MAX {
guard {
 	context(nearest_object > 0.15 OR power_draw <= 40.0 OR current_velocity < 0.40)
 	features(selected(rebet_frog.MED_SPEED)) 
 	}
action { select_variant(rebet_frog.HI_SPEED)}
};
