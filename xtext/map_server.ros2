nav2_map_server:
  artifacts:
    map_server:
      node: /map_server
      publishers:
        'bond':
          type: 'bond/msg/Status'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'map':
          type: 'nav_msgs/msg/OccupancyGrid'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: transient_local
        'map_server/transition_event':
          type: 'lifecycle_msgs/msg/TransitionEvent'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
      subscribers:
        'bond':
          type: 'bond/msg/Status'
        'clock':
          type: 'rosgraph_msgs/msg/Clock'
      serviceservers:
        'map_server/change_state':
          type: 'lifecycle_msgs/srv/ChangeState'
        'map_server/get_available_states':
          type: 'lifecycle_msgs/srv/GetAvailableStates'
        'map_server/get_available_transitions':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'map_server/get_state':
          type: 'lifecycle_msgs/srv/GetState'
        'map_server/get_transition_graph':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'map_server/load_map':
          type: 'nav2_msgs/srv/LoadMap'
        'map_server/map':
          type: 'nav_msgs/srv/GetMap'
      parameters:
        '/bond_disable_heartbeat_timeout':
          type: Boolean
          value: true
        'frame_id':
          type: String
          value: "map"
        'topic_name':
          type: String
          value: "map"
        'use_sim_time':
          type: Boolean
          value: true
        'yaml_filename':
          type: String
          value: "/home/ega/rebet_ws/install/rebet_frog/share/rebet_frog/config/acsos2024_map.yaml"
