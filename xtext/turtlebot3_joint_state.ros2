turtlebot3_gazebo:
  artifacts:
    turtlebot3_joint_state:
      node: /turtlebot3_joint_state
      publishers:
        'joint_states':
          type: 'sensor_msgs/msg/JointState'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
      subscribers:
        'clock':
          type: 'rosgraph_msgs/msg/Clock'
      parameters:
        'use_sim_time':
          type: Boolean
          value: true
