nav2_smoother:
  artifacts:
    smoother_server:
      node: /smoother_server
      publishers:
        'bond':
          type: 'bond/msg/Status'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'plan_smoothed':
          type: 'nav_msgs/msg/Path'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
        'smoother_server/transition_event':
          type: 'lifecycle_msgs/msg/TransitionEvent'
          qos:
          # profile:
          # history: UNKNOWN
          # depth:
            reliability: reliable
            durability: volatile
      subscribers:
        'bond':
          type: 'bond/msg/Status'
        'clock':
          type: 'rosgraph_msgs/msg/Clock'
        'global_costmap/costmap_raw':
          type: 'nav2_msgs/msg/Costmap'
        'global_costmap/published_footprint':
          type: 'geometry_msgs/msg/PolygonStamped'
      actionservers:
        'smooth_path':
          type: 'nav2_msgs/action/SmoothPath'
      serviceservers:
        'smoother_server/change_state':
          type: 'lifecycle_msgs/srv/ChangeState'
        'smoother_server/get_available_states':
          type: 'lifecycle_msgs/srv/GetAvailableStates'
        'smoother_server/get_available_transitions':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
        'smoother_server/get_state':
          type: 'lifecycle_msgs/srv/GetState'
        'smoother_server/get_transition_graph':
          type: 'lifecycle_msgs/srv/GetAvailableTransitions'
      parameters:
        '/bond_disable_heartbeat_timeout':
          type: Boolean
          value: true
        'costmap_topic':
          type: String
          value: "global_costmap/costmap_raw"
        'footprint_topic':
          type: String
          value: "global_costmap/published_footprint"
        'robot_base_frame':
          type: String
          value: "base_link"
        'simple_smoother.do_refinement':
          type: Boolean
          value: true
        'simple_smoother.max_its':
          type: Integer
          value: 1000
        'simple_smoother.plugin':
          type: String
          value: "nav2_smoother::SimpleSmoother"
        'simple_smoother.tolerance':
          type: Double
          value: 1e-10
        'simple_smoother.w_data':
          type: Double
          value: 0.2
        'simple_smoother.w_smooth':
          type: Double
          value: 0.3
        'smoother_plugins':
          type: Array[String]
          value: ['simple_smoother']
        'transform_tolerance':
          type: Double
          value: 0.1
        'use_sim_time':
          type: Boolean
          value: true
